# Environment
NODE_ENV=development
PORT=3000

# Auth Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------------------

# Option A: Local Docker Postgres (Development & Local Testing)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mawid_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mawid_dev"

# Option B: Neon Cloud PostgreSQL (Deployed Demo Only)
# - DATABASE_URL: Uses the connection pooler (-pooler) for scalable query pooling.
#                 Requires `pgbouncer=true` and `connection_limit` for transaction pooling.
# - DIRECT_URL:   Direct non-pooled connection (no -pooler) required by Prisma Migrations.
# (Note: channel_binding=require is excluded as it causes SSL handshake failures with PgBouncer)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------------------
# UPSTASH REDIS CONFIGURATION (Distributed Locking & High-Speed Caching)
# -----------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"
